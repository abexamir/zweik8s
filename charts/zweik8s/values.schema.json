{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "ipv4OrEmpty": {
      "type": "string",
      "pattern": "^$|^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "tunnelPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "protocol": { "type": "string", "enum": ["TCP", "UDP", "tcp", "udp"] },
    "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "portMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "tunnelPort"],
      "properties": {
        "port": { "$ref": "#/definitions/port" },
        "tunnelPort": { "$ref": "#/definitions/tunnelPort" },
        "protocol": { "$ref": "#/definitions/protocol" }
      }
    }
  },
  "properties": {
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/definitions/ipv4OrEmpty" },
        "listenPort": { "type": "integer", "minimum": 1024, "maximum": 65534 },
        "mtu": { "type": "integer", "minimum": 576, "maximum": 1420 },
        "interface": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,15}$" },
        "controlPort": { "$ref": "#/definitions/tunnelPort" }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/definitions/ipv4OrEmpty" },
        "endpoint": { "type": "string", "pattern": "^$|^[^:\\s]+:[0-9]{1,5}$" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["LoadBalancer", "NodePort", "ClusterIP"] },
        "nodePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "externalTrafficPolicy": { "type": "string", "enum": ["Local", "Cluster"] }
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ports"],
        "properties": {
          "name": { "$ref": "#/definitions/name" },
          "host": { "type": "string" },
          "service": { "type": ["string", "null"] },
          "namespace": { "type": ["string", "null"] },
          "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/portMap" } }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ports"],
        "properties": {
          "name": { "$ref": "#/definitions/name" },
          "serviceName": { "type": "string" },
          "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/portMap" } },
          "callers": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace"],
              "properties": {
                "namespace": { "type": "string" },
                "matchLabels": { "type": ["object", "null"], "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSessions": { "type": "integer", "minimum": 1 },
        "connectTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "udpIdleSeconds": { "type": "integer", "minimum": 1 },
        "udpRefreshSeconds": { "type": "integer", "minimum": 1 },
        "tcpCongestion": { "type": "string" },
        "socketBufferBytes": { "type": "integer", "minimum": 65536 },
        "keepaliveIdleSeconds": { "type": "integer", "minimum": 1 },
        "keepaliveIntervalSeconds": { "type": "integer", "minimum": 1 },
        "keepaliveCount": { "type": "integer", "minimum": 1 },
        "probeIntervalSeconds": { "type": "integer", "minimum": 1 },
        "peerTimeoutSeconds": { "type": "integer", "minimum": 2 },
        "wireguardKeepaliveSeconds": { "type": "integer", "minimum": 0 },
        "drainSeconds": { "type": "integer", "minimum": 0 },
        "workers": { "type": "integer", "minimum": 0 },
        "splice": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    }
  }
}
